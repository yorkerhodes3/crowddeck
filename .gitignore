# Node
node_modules/
npm-debug.log*
yarn-error.log*

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Local scratch
*.local
.env
.env.*
!.env.example

# Probe artefacts written by tools/test/licence-lint.test.js. Present only if a
# run was interrupted; the suite clears them on its next start.
_lint_probe.*
_lint_sandbox/

# SPIKE-2 build artefacts. vendor/miniaudio.h is fetched by CMake or the
# documented gcc line; measurements are kept zipped as evidence.
spike/spike-2/vendor/
spike/spike-2/runs/*.exe
spike/spike-2/runs/*.csv
spike/spike-2/build/
